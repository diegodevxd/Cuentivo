# Ejemplo de configuración de Cloud Functions. Copia este archivo a `functions/.env.<tu-proyecto>`
# (está en .gitignore) y llena los valores. NUNCA subas el archivo real.

# Verificación cruzada con MexaLM Ledger (el modelo propio que revisa la lectura de la libreta).
MEXALM_LEDGER_CROSSCHECK=false
MEXALM_LEDGER_URL=https://tu-servicio-del-ledger.example.com
# Vuelca respuestas del Ledger a disco solo en el emulador. En producción siempre false.
MEXALM_LEDGER_DEBUG_DUMP=false

# Los secretos NO van aquí: se guardan en Google Secret Manager con
#   firebase functions:secrets:set <NOMBRE>
#   - CUENTIVOAI_GEMINI_API_KEY            (Gemini, del lado del servidor)
#   - CUENTIVOAI_PLAY_SERVICE_ACCOUNT_KEY  (validación de compras de Google Play)
#   - MEXALM_LEDGER_TOKEN                  (token del servicio MexaLM Ledger)
