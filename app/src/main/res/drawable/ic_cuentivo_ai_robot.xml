<?xml version="1.0" encoding="utf-8"?>
<!--
  Local robot/AI vector (24dp), tintable by Icon. No text, no emoji, no bitmap.
  The head path uses evenOdd so the eyes read as cut-outs once tinted.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- antenna -->
    <path
        android:pathData="M12,2 L12,5"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.5"
        android:strokeLineCap="round" />
    <path
        android:pathData="M12,2 m-1.5,0 a1.5,1.5 0 1,0 3,0 a1.5,1.5 0 1,0 -3,0"
        android:fillColor="#FF000000" />

    <!-- head with eye cut-outs (evenOdd) -->
    <path
        android:pathData="M5,6 h14 a2,2 0 0 1 2,2 v8 a2,2 0 0 1 -2,2 h-14 a2,2 0 0 1 -2,-2 v-8 a2,2 0 0 1 2,-2 z M8,11 m-1.5,0 a1.5,1.5 0 1,0 3,0 a1.5,1.5 0 1,0 -3,0 M16,11 m-1.5,0 a1.5,1.5 0 1,0 3,0 a1.5,1.5 0 1,0 -3,0"
        android:fillColor="#FF000000"
        android:fillType="evenOdd" />

    <!-- mouth -->
    <path
        android:pathData="M9,16 h6"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.5"
        android:strokeLineCap="round" />
</vector>